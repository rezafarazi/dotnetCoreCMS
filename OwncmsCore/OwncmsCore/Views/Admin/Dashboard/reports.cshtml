@using OwncmsCore.Services.Panel.Report;
@{
    Layout = "~/Views/Admin/Themplate/__Admin_Layout_Temp.cshtml";
    Report_Service.Reports_Var UsersReports = ViewBag.AllReports;
}

       






<!-- partial -->
<div class="main-panel">
    <div class="content-wrapper">
        <div class="page-header">
            <h3 class="page-title">
                <span class="page-title-icon bg-gradient-primary text-white mr-2">
                    <i class="mdi mdi-chart-bubble"></i>
                </span>@OwncmsCore.Language.all_strings.reports
            </h3>
        </div>

        <div class="row">


            <!--Bottom Side Of Content Start-->
            <div class="col-lg-12 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title" style="text-align: right;">@OwncmsCore.Language.all_strings.reports</h4>
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>@OwncmsCore.Language.all_strings.id</th>
                                    <th>@OwncmsCore.Language.all_strings.text</th>
                                    <th>@OwncmsCore.Language.all_strings.type</th>
                                    <th>@OwncmsCore.Language.all_strings.reporter_user</th>
                                    <th>@OwncmsCore.Language.all_strings.old_notifications</th>
                                    <th>@OwncmsCore.Language.all_strings.status</th>
                                </tr>
                            </thead>
                            <tbody>

                                @for (int i = 0; i < UsersReports.AllReports.Count; i++)
                                {
                                <tr>
                                    <td>@UsersReports.AllReports[i].id</td>
                                    <td>@UsersReports.AllReports[i].content</td>
                                    <td>@UsersReports.ReportType[i].title</td>
                                    <td><i onclick="Open_Link_Dialog(this, window.location.protocol + '//' + window.location.host + '/Admin/Panel/UserManager/Edit_User/@UsersReports.AllReports[i].user_id.id')"><i class="mdi mdi-account-edit" style="font-size: 20px;color:#007bff;cursor: pointer;"></i></i></td>
                                    <td><i onclick="Open_Link_Dialog(this, window.location.protocol + '//' + window.location.host + '/Admin/Panel/UserManager/Notifications/@UsersReports.AllReports[i].user_id.id')" class="mdi mdi-comment" style="font-size: 20px;color:#007bff;cursor: pointer;"></i></td>
                                    <td><a href="~/Admin/Admin/Reports/View/@UsersReports.AllReports[i].id" style="color:#FF0000;">@OwncmsCore.Language.all_strings.not_seen</a></td>
                                </tr>
                                }

                            </tbody>
                        </table>

                        @if (UsersReports.AllReports.Count <= 0)
                        {
                            <tr>
                                <div style="margin-top:60px;">
                                    <img src="~/Assets/Admin/images/icons/empty.png" width="150px" style="display:block;margin:0 auto;" />
                                    <p style="width:100%;text-align:center;color:#666;margin-top:20px;">@OwncmsCore.Language.all_strings.not_found</p>
                                </div>
                            </tr>
                        }
                    </div>
                </div>
            </div>
                <!--Bottom Side Of Content Start-->

        </div>

    </div>
        <!-- content-wrapper ends -->