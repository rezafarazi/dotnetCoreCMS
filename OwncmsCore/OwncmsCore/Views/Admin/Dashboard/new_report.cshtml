@using OwncmsCore.Models.DatabaseModels;
@{
    Layout = "~/Views/Admin/Themplate/__Admin_Layout_Temp.cshtml";

    List<Reports_Tbl> Reports = ViewBag.Reports;
    
}
     
<!-- partial -->
<div class="main-panel">
    <div class="content-wrapper">
        <div class="page-header">
            <h3 class="page-title">
                <span class="page-title-icon bg-gradient-primary text-white mr-2">
                    <i class="mdi mdi-chart-bubble"></i>
                </span>@OwncmsCore.Language.all_strings.new_report
            </h3>
        </div>

        <div class="row">

            <!--Right Side Of Content Start-->
            <div class="col-lg-6 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        <form class="forms-sample" method="post">
                            @Html.AntiForgeryToken()
                            <div class="form-group">
                                <label for="exampleInputUsername1">@OwncmsCore.Language.all_strings.new_report</label>
                                <input type="text" class="form-control" id="exampleInputUsername1" placeholder="@OwncmsCore.Language.all_strings.new_report" name="title">
                            </div>
                            <button style="width: 100%;" type="submit" class="btn btn-gradient-primary mr-2">@OwncmsCore.Language.all_strings.done</button>
                        </form>
                    </div>
                </div>
            </div>
            <!--Right Side Of Content End-->
            
            <!--Left Side Of Content Start-->
            <div class="col-lg-6 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">@OwncmsCore.Language.all_strings.reports</h4>
                        </p>
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>@OwncmsCore.Language.all_strings.id</th>
                                    <th>@OwncmsCore.Language.all_strings.title</th>
                                    <th>@OwncmsCore.Language.all_strings.delete</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Reports.Count; i++)
                                {
                                    <tr>
                                        <th>@Reports[0].id</th>
                                        <th>@Reports[0].title</th>
                                        <td><a href="~/Admin/NewReport/Remove/@Reports[0].id"><i class="mdi mdi-delete" style="color: #F00;font-size: 20px;"></i></a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        @if (Reports.Count <= 0)
                        {
                            <tr>
                                <div style="margin-top:60px;">
                                    <img src="~/Assets/Admin/images/icons/empty.png" width="150px" style="display:block;margin:0 auto;" />
                                    <p style="width:100%;text-align:center;color:#666;margin-top:20px;">@OwncmsCore.Language.all_strings.not_found</p>
                                </div>
                            </tr>
                        }

                    </div>
                </div>
            </div>
            <!--Left Side Of Content End-->


        </div>

    </div>
    <!-- content-wrapper ends -->
