@using OwncmsCore.Models.DatabaseModels;
@{
    Layout = "~/Views/Admin/Themplate/__Admin_Layout_Temp.cshtml";
    List<Categories_Tbl> categories = ViewBag.AllCategories;

    Categories_Tbl edit_category = ViewBag.EditCategory;

}



<!-- partial -->
<div class="main-panel">
    <div class="content-wrapper">
        <div class="page-header">
            <h3 class="page-title">
                <span class="page-title-icon bg-gradient-primary text-white mr-2">
                    <i class="mdi mdi-format-list-bulleted"></i>
                </span>@OwncmsCore.Language.all_strings.categoris
            </h3>
        </div>

        <div class="row">

            <!--Right Side Of Content Start-->
            <div class="col-md-6 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        <form method="post" action="/Admin/Categoreis/Update">
                            @Html.AntiForgeryToken()
                            <input type="text" name="Category_Id" style="display:none;" value="@edit_category.id"/>
                            <div class="form-group">
                                <label for="exampleInputUsername1" style="width: 100%;text-align: right;">@OwncmsCore.Language.all_strings.name</label>
                                <input type="text" class="form-control" id="exampleInputUsername1" placeholder="@OwncmsCore.Language.all_strings.category_name" name="Category_Name" value="@edit_category.title">
                            </div>
                            <div class="form-group">
                                <label for="exampleInputPassword1" style="width: 100%;text-align: right;">@OwncmsCore.Language.all_strings.root</label>
                                <select id="category_combat" class="form-control" name="Root_Cat" onchange="onchange_category(this)">
                                    <option value="0">@OwncmsCore.Language.all_strings.root</option>

                                    @for (int i = 0; i < categories.Count; i++)
                                    {
                                        if (@categories[i].id.ToString() != edit_category.id.ToString())
                                        {
                                            if (edit_category.Root_Id == @categories[i].id.ToString())
                                            {
                                                <option selected value="@categories[i].id">@categories[i].title</option>
                                            }
                                            else
                                            {
                                                <option value="@categories[i].id">@categories[i].title</option>
                                            }
                                        }
                                    }

                                </select>
                            </div>
                            <div class="form-group">
                                <label for="exampleInputUsername1" style="width: 100%;text-align: right;">@OwncmsCore.Language.all_strings.icon_address</label>
                                <input type="text" class="form-control" id="exampleInputUsername1" placeholder="@OwncmsCore.Language.all_strings.icon_address_link" name="Icon_Address" value="@edit_category.link">
                            </div>
                            <div class="form-group">
                                <label for="exampleInputUsername1" style="width: 100%;text-align: right;">@OwncmsCore.Language.all_strings.ca_link</label>
                                <input type="text" class="form-control" id="exampleInputUsername1" placeholder="@OwncmsCore.Language.all_strings.ca_link" name="link" value="@edit_category.Icon_Address">
                            </div>
                            <div class="form-group">
                                <label for="exampleInputUsername1" style="width: 100%;text-align: right;">@OwncmsCore.Language.all_strings.more_data</label>
                                <textarea style="resize:vertical;text-align:justify;" class="form-control" name="TextData">@edit_category.text</textarea>
                            </div>
                            <div class="form-group">
                                <label for="exampleInputPassword1" style="width: 100%;text-align: right;">@OwncmsCore.Language.all_strings.visible</label>
                                <select class="form-control" name="Visibleity">
                                    @if(edit_category.Enabled_Flag=="Visible")
                                    {
                                        <option value="Visible" selected>@OwncmsCore.Language.all_strings.visible</option>
                                        <option value="Hide" >@OwncmsCore.Language.all_strings.hide</option>   
                                    }
                                    else
                                    {
                                        <option value="Visible">@OwncmsCore.Language.all_strings.visible</option>
                                        <option value="Hide" selected>@OwncmsCore.Language.all_strings.hide</option>   
                                    }
                                </select>
                            </div>
                            <button style="width: 100%;" type="submit" class="btn btn-gradient-primary mr-2">@OwncmsCore.Language.all_strings.n</button>
                        </form>
                    </div>
                </div>
            </div>
            <!--Right Side Of Content End-->




            <!--Bottom Side Of Content Start-->
            <div class="col-lg-12 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title" style="text-align: right;">دسته بندی ها</h4>
                        </p>
                        @if(categories.Count > 0)
                        {
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>@OwncmsCore.Language.all_strings.id</th>
                                    <th>@OwncmsCore.Language.all_strings.name</th>
                                    <th>@OwncmsCore.Language.all_strings.sub</th>
                                    <th>@OwncmsCore.Language.all_strings.opration</th>
                                    <th>@OwncmsCore.Language.all_strings.delete</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < categories.Count; i++)
                                {
                                    <tr>
                                        <td>@categories[i].id</td>
                                        <td>@categories[i].title</td>

                                        @if(categories[i].Root_Id!="0")
                                        {
                                            <td>@categories[i].Root_Id</td>
                                        }
                                        else
                                        {
                                            <td>@OwncmsCore.Language.all_strings.root</td>
                                        }

                                        <td><a href="?Cat_Id=@categories[i].id"><i class="mdi mdi-table-edit" style="font-size: 20px;"></i></a></td>
                                        <td><a href="/Admin/Categoreis/Delete?Delete=@categories[i].id"><i class="mdi mdi-delete" style="color: #F00;font-size: 20px;"></i></a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        }
                        else
                        {
                            <div style="width: 100%;height: 250px;display: flex;justify-content: center;align-items: center;">
                                <div style="width: 150px;">
                                    <img style="margin: 0 auto;" src="/Assets/Admin/images/icons/empty.png" width="150px"/>
                                    <p style="margin: 10px auto;text-align: center;">@OwncmsCore.Language.all_strings.notfound</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <!--Bottom Side Of Content Start-->

        </div>

    </div>
    <!-- content-wrapper ends -->








    <script>

        function onchange_category(e)
        {
            var sub_section = window.document.getElementById('sub_section');
            var category_combat = window.document.getElementById('category_combat');

            if (category_combat.value == "Root")
            {    
                sub_section.style.display = "none";
            }
            else
            {
                sub_section.style.display = "block";
            }
        }

        window.addEventListener('load', function (e) {
            
        });

    </script>

    <style>
        
        #sub_section
        {
            display: block;
        }
        
    </style>

