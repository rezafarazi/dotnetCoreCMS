﻿@using OwncmsCore.Models.DatabaseModels;
@{
    Layout = "~/Views/Admin/Themplate/__Admin_Layout_Temp.cshtml";

    List<Tuple<transcation_tbl, users_tbl>> result = ViewBag.AllTransations;
}

<div class="main-panel">
    <div class="content-wrapper">
        <div class="page-header">
            <h3 class="page-title">
                <span class="page-title-icon bg-gradient-primary text-white mr-2">
                    <i class="mdi mdi-card"></i>
                </span></span>@OwncmsCore.Language.all_strings.transactions
            </h3>
        </div>

        <div class="row">

            <div class="col-lg-12 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        @if (result.Count() > 0)
                        {
                            <table th:if="${transactions.size()>0}" class="table">
                                <thead>
                                    <tr>
                                        <th>@OwncmsCore.Language.all_strings.id</th>
                                        <th>@OwncmsCore.Language.all_strings.name @OwncmsCore.Language.all_strings.family</th>
                                        <th>@OwncmsCore.Language.all_strings.date</th>
                                        <th>@OwncmsCore.Language.all_strings.value</th>
                                    </tr>
                                </thead>
                                <tbody>

                                    @foreach (Tuple<transcation_tbl, users_tbl> item in result)
                                    {
                                        <tr>
                                            <td>@item.Item1.id</td>
                                            <td>@item.Item2.name @item.Item2.family</td>
                                            <td>@item.Item1.date</td>
                                            <td>@item.Item1.value</td>
                                        </tr>
                                    }

                                </tbody>
                            </table>
                        }
                        else
                        {
                            <div th:unless="${transactions.size()>0}" style="width: 100%;height: 250px;display: flex;justify-content: center;align-items: center;">
                                <div style="width: 150px;">
                                    <img style="margin: 0 auto;" src="~/Assets/Admin/images/icons/empty.png" width="150px"/>
                                    <p style="margin: 10px auto;text-align: center;">@OwncmsCore.Language.all_strings.transationNotfound</p>
                                </div>
                            </div>
                        }

                    </div>
                </div>
            </div>

        </div>

    </div>