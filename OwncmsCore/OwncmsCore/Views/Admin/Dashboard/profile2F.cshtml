@using OwncmsCore.Models.DatabaseModels;
@{
    Layout = "~/Views/Admin/Themplate/__Admin_Layout_Temp.cshtml";
    Users_Tbl User = ViewBag.User_Data;
}
     

<!-- partial -->
<div class="main-panel">
    <!--Send Notification To User Start-->
    <div class="content-wrapper">
        <div class="page-header">
            <h3 class="page-title">
                <span class="page-title-icon bg-gradient-primary text-white mr-2">
                    <i class="mdi mdi-qrcode-scan "></i>
                </span>@OwncmsCore.Language.all_strings.profile
            </h3>
        </div>
        <div class="row">
            <div class="col-md-12 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title" style="text-align: center;">@OwncmsCore.Language.all_strings.active_2f_pass</h4>
                        <p class="card-description" style="text-align: center;">@OwncmsCore.Language.all_strings.please_scan_under_qr_code</p>
                        <div>
                            <img style="display:block;margin:0 auto;" src="@ViewBag.GoogleAuth2F" width="150px" height="150px" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--Send Notification To User End-->








