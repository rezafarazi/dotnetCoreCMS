﻿@using OwncmsCore.Models.DatabaseModels;
@{
    Layout = "~/Views/Admin/Themplate/__Admin_Layout_Temp.cshtml";
    List<posts_tbls> all_posts = ViewBag.AllPosts;
}




<!-- partial -->
<div class="main-panel">
    <div class="content-wrapper">
        <div class="page-header">
            <h3 class="page-title">
                <span class="page-title-icon bg-gradient-primary text-white mr-2">
                  <i class="mdi mdi-paperclip"></i>
                </span>@OwncmsCore.Language.all_strings.allposts
            </h3>
        </div>

        <div class="row">

            <div class="col-lg-12 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        @if (all_posts.Count > 0)
                        {
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>@OwncmsCore.Language.all_strings.id</th>
                                        <th>@OwncmsCore.Language.all_strings.title</th>
                                        <th>@OwncmsCore.Language.all_strings.edit</th>
                                        <th>@OwncmsCore.Language.all_strings.delete</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < all_posts.Count; i++)
                                    {
                                        <tr>
                                            <td>@all_posts[i].id</td>
                                            <td>@all_posts[i].title</td>
                                            <td><i onclick="Open_Link_Dialog(this,'/Admin/Panel/AllPosts/@all_posts[i].id')" class="mdi mdi-table-edit" style="color:var(--primary);font-size: 20px;cursor: pointer;"></i></td>
                                            <td><a href="/Admin/Panel/AllPosts/Remove/@all_posts[i].id"><i class="mdi mdi-delete" style="color: #F00;font-size: 20px;"></i></a></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <div style="width: 100%;height: 250px;display: flex;justify-content: center;align-items: center;">
                                <div style="width: 150px;">
                                    <img style="margin: 0 auto;" src="/Assets/Admin/images/icons/empty.png" width="150px"/>
                                    <p style="margin: 10px auto;text-align: center;">@OwncmsCore.Language.all_strings.notfound</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

        </div>

    </div>
    <!-- content-wrapper ends -->
